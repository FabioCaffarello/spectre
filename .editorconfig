root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown allows trailing whitespace for hard line breaks
[*.md]
trim_trailing_whitespace = false

# Tab-indented languages and files
[Makefile]
indent_style = tab

[justfile]
indent_style = tab

[*.go]
indent_style = tab
indent_size = 4

# Wider indent for these languages by convention
[*.{py,pyi}]
indent_size = 4

[*.rs]
indent_size = 4

[*.proto]
indent_size = 2
