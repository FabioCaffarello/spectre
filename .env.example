# Spectre — local development env vars.
#
# Copy to `.env` (gitignored) and source from your shell or rely on
# the compose / just recipes that load it automatically. Values
# below match the docker-compose.yml dev defaults; production
# deployments source these from Kubernetes Secrets per ADR-0023 §10.

# PostgreSQL — engine job state + control-plane reads (ADR-0023 §2).
# Same URL the engine and the operator both consume.
SPECTRE_POSTGRES_URL=postgres://spectre:spectre_dev_password@localhost:5432/spectre

# Optional pool size for the engine (default 5). Operator pgxpool
# uses its built-in default unless you set its own override.
# SPECTRE_POSTGRES_MAX_CONNS=5

# Redis — adapter session metadata cache (ADR-0023 §4 + §5).
# Required by every adapter: each one PINGs Redis at startup and
# exits non-zero if unreachable. Each adapter writes session
# metadata at Initialize and validates the adapter_instance_id
# on every subsequent RPC; restart invalidation is the §5
# contract.
SPECTRE_REDIS_URL=redis://localhost:6379/0

# Optional override for the adapter's process-startup UUID. Set
# only by the conformance harness for the restart-invalidation
# tests; production deployments leave it unset and the adapter
# generates a fresh UUID on every process startup. See ADR-0023
# §5 R4.3 addendum.
# SPECTRE_ADAPTER_INSTANCE_ID=

# Kafka — engine producer target for OutputSink.Kafka jobs
# (ADR-0023 §3 R4.4 addendum). Comma-separated host:port list,
# matching librdkafka's `bootstrap.servers` shape. Required only
# when the engine should accept Kafka-sinked ScrapeJobs; if
# unset, the engine logs a startup warning and Kafka jobs fail
# fast with `error_code = "KAFKA_UNAVAILABLE"`.
SPECTRE_KAFKA_BROKERS=localhost:9092

# Optional producer linger window in milliseconds (default 10 —
# small batch window for low-latency dev). Production deployments
# may raise this for throughput tuning.
# SPECTRE_KAFKA_LINGER_MS=10

# S3-compatible object store — engine target for OutputSink.S3
# jobs (ADR-0024 §3). Compose runs MinIO at `localhost:9000`
# (S3 API) + `localhost:9001` (web console). All four variables
# are optional: when none are set, the engine logs INFO
# ("BYO-credentials mode") and uses the AWS default credential
# chain (IAM role / SSO / profile) — the production-typical
# shape. When set, env values override the default chain.
SPECTRE_S3_ENDPOINT=http://localhost:9000
SPECTRE_S3_ACCESS_KEY_ID=spectre_dev_access
SPECTRE_S3_SECRET_ACCESS_KEY=spectre_dev_secret_key
# Default region for S3 puts when the CRD does not specify;
# MinIO accepts any string. Default us-east-1 mirrors the CRD
# kubebuilder default.
SPECTRE_S3_REGION=us-east-1

# Engine listen port (default 9090).
SPECTRE_ENGINE_PORT=9090

# Engine endpoint the operator dials when a ScrapeJob's
# spec.engineRef is unset. Match SPECTRE_ENGINE_PORT.
SPECTRE_ENGINE_ENDPOINT=127.0.0.1:9090

# Adapter endpoints the engine dials. ADR-0021 §4 reserves these
# port numbers; defaults here mirror the per-adapter run recipes.
SPECTRE_PLAYWRIGHT_ENDPOINT=127.0.0.1:9091
SPECTRE_SELENIUMBASE_ENDPOINT=127.0.0.1:9092
SPECTRE_CURL_IMPERSONATE_ENDPOINT=127.0.0.1:9093
