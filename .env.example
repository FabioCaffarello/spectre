# Spectre — local development env vars.
#
# Copy to `.env` (gitignored) and source from your shell or rely on
# the compose / just recipes that load it automatically. Values
# below match the docker-compose.yml dev defaults; production
# deployments source these from Kubernetes Secrets per ADR-0023 §10.

# PostgreSQL — engine job state + control-plane reads (ADR-0023 §2).
# Same URL the engine and the operator both consume.
SPECTRE_POSTGRES_URL=postgres://spectre:spectre_dev_password@localhost:5432/spectre

# Optional pool size for the engine (default 5). Operator pgxpool
# uses its built-in default unless you set its own override.
# SPECTRE_POSTGRES_MAX_CONNS=5

# Engine listen port (default 9090).
SPECTRE_ENGINE_PORT=9090

# Engine endpoint the operator dials when a ScrapeJob's
# spec.engineRef is unset. Match SPECTRE_ENGINE_PORT.
SPECTRE_ENGINE_ENDPOINT=127.0.0.1:9090

# Adapter endpoints the engine dials. ADR-0021 §4 reserves these
# port numbers; defaults here mirror the per-adapter run recipes.
SPECTRE_PLAYWRIGHT_ENDPOINT=127.0.0.1:9091
SPECTRE_SELENIUMBASE_ENDPOINT=127.0.0.1:9092
SPECTRE_CURL_IMPERSONATE_ENDPOINT=127.0.0.1:9093
