# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Claude Code memory (private to each contributor's local agent)
MEMORY.md
memory/

# Environment
.env
.env.local
.env.*.local

# Per-developer Compose overrides (ADR-0023 §9 / R4.2). The base
# stack in docker-compose.yml is committed; per-developer tweaks
# (port remaps, volume mounts) live in compose.override.yml so
# `docker compose up` picks them up without polluting source.
compose.override.yml

# Rust
target/
**/*.rs.bk

# Go
bin/
*.exe
*.test
*.out
vendor/

# Source-controlled `bin/` directories that are not Go build outputs.
# `engines/engine/src/bin/` hosts Cargo binary entry points (e.g. the
# `spectre` CLI per ADR-0013); Cargo's convention names the directory
# `bin/`, which collides with the Go rule above.
!engines/engine/src/bin/
!engines/engine/src/bin/**

# Node / TypeScript
node_modules/
dist/
build/
# `build/docker/` (R6.1) and `build/kind/` (R6.3) are source-controlled
# — toolchain version pins for bake, kind cluster config + .gitignore
# for the operator's local API surface. The `build/` rule above
# targets Node/TS frontend build outputs at any depth; the negation
# below un-excludes the *top-level* `/build/` directory and re-excludes
# everything inside it except `/build/docker/` and `/build/kind/`.
# Anchored paths (leading slash) keep the carve-out from leaking into
# nested `build/` dirs. `/build/kind/kubeconfig` is the generated
# kubeconfig and stays ignored via `build/kind/.gitignore`.
!/build/
/build/*
!/build/docker/
!/build/docker/**
!/build/kind/
!/build/kind/**
# `tools/build/` (R6.5.1) hosts the version-coherence script that
# enforces build/docker/versions.env <-> Dockerfile ARG defaults.
# Source-controlled; carved out from the unanchored `build/` rule
# above which targets Node/TS build outputs.
!tools/build/
!tools/build/**
.pnpm-store/
.turbo/
.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Generated code from protobuf (regenerated via buf or build.rs).
# See `docs/adr/0007-protocol-code-generation.md` for the layout.
proto/gen/
adapters/playwright/src/proto/

# Logs and local caches
*.log
.cache/

*.zip

# Output produced by example jobs.
examples/hello-hackernews/stories.jsonl
