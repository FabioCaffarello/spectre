# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Claude Code memory (private to each contributor's local agent)
MEMORY.md
memory/

# Environment
.env
.env.local
.env.*.local

# Rust
target/
**/*.rs.bk

# Go
bin/
*.exe
*.test
*.out
vendor/

# Source-controlled `bin/` directories that are not Go build outputs.
# `core/engine/src/bin/` hosts Cargo binary entry points (e.g. the
# `spectre` CLI per ADR-0013); Cargo's convention names the directory
# `bin/`, which collides with the Go rule above.
!core/engine/src/bin/
!core/engine/src/bin/**

# Node / TypeScript
node_modules/
dist/
build/
.pnpm-store/
.turbo/
.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Generated code from protobuf (regenerated via buf or build.rs).
# See `docs/adr/0007-protocol-code-generation.md` for the layout.
proto/gen/
adapters/playwright/src/proto/

# Logs and local caches
*.log
.cache/

*.zip

# Output produced by the hello-hackernews example binary.
examples/hello-hackernews/stories.jsonl
