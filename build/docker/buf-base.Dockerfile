# syntax=docker/dockerfile:1.7
#
# Shared codegen tooling stage. Provides the `buf` binary at
# /usr/local/bin/buf for the four consumer images that do
# language-specific proto generation (control-plane,
# curl-impersonate, playwright, seleniumbase). The engine image
# does NOT consume this stage — Rust bindings are generated by
# `prost-build` inside the Cargo build (engines/engine/build.rs),
# not via `buf generate`.
#
# Built by bake's `buf-base` target. Consumers reference it via
# `contexts: { buf-base = "target:buf-base" }` and pull the
# binary with `COPY --from=buf-base /usr/local/bin/buf
# /usr/local/bin/buf`. The image itself is never tagged for
# loading or pushing — bake's `output = ["type=cacheonly"]`
# keeps it as a cache-only build artefact.
#
# Multi-arch: BuildKit propagates the consumer's TARGETARCH
# automatically when building via `contexts:`, so this stage is
# multi-arch-ready by virtue of `ARG TARGETARCH` plus the
# arch-aware buf release URL. Verified asset names:
#   buf-Linux-x86_64   (linux/amd64)
#   buf-Linux-aarch64  (linux/arm64)
#
# Refs: ADR-0007 (proto codegen at build time);
# ADR-0018 §3 R6.5.4 update (this extraction);
# build/docker/README.md "Shared codegen base" section.

FROM debian:12-slim

ARG BUF_VERSION
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && BUF_ARCH=$(case "${TARGETARCH:-amd64}" in \
        amd64|x86_64)  echo "x86_64" ;; \
        arm64|aarch64) echo "aarch64" ;; \
        *) echo "unsupported BUF arch: ${TARGETARCH}"; exit 1 ;; \
    esac) \
 && curl -fsSL -o /usr/local/bin/buf \
      "https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/buf-Linux-${BUF_ARCH}" \
 && chmod +x /usr/local/bin/buf \
 && buf --version
