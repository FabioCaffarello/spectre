# Toolchain versions for container images and (R6.3) the Devcontainer.
#
# Single source of truth. Bumping a line here propagates to every
# consumer the next time `just images` (or any bake-driven flow) runs.
# Consumers:
#   * docker-bake.hcl — sourced by `just images` before invoking
#     `docker buildx bake`; bake variables resolve from the env at
#     bake time.
#   * The justfile umbrella recipes (`images`, `images-smoke`,
#     `pw-image`, `sb-image`, `curl-imp-image`, `engine-image`,
#     `op-build-image`) — `set -a; source build/docker/versions.env;
#     set +a` before invoking bake.
#   * R6.3 — Devcontainer post-create script will source this file to
#     install matching toolchains natively.
#   * R7.x CI workflows will pass these values as bake variables so
#     CI builds the same versions contributors do locally.
#
# This file is the only place a version string lives. A grep across
# core/, adapters/, docker-bake.hcl, justfile for hardcoded version
# strings (e.g. "1.85", "1.25", "27.2", "1.49.0") should return only
# matches inside this file, lockfiles, or comments.
#
# Format is POSIX shell-sourceable (KEY=VALUE) so every consumer can
# read it without a YAML/TOML parser. Comments are # to end-of-line.

# Rust toolchain for the engine builder stage. Tracks the engine's
# transitive dep MSRV — `aws-sdk-sts` 1.94 (pulled by `aws-sdk-s3`
# R5.1) requires rustc 1.88; the engine's own Cargo.toml pins
# `rust-version = "1.85"` but the toolchain we *build with* can be
# newer. R6.3 will land matching rustup pin in the Devcontainer.
RUST_VERSION=1.88

# Go toolchain for the control-plane and curl-impersonate adapter
# builder stages. Tracks the go.mod toolchain pin in
# core/control-plane/go.mod and adapters/curl-impersonate/go.mod.
GO_VERSION=1.25

# Node toolchain for the Playwright adapter builder stage.
NODE_VERSION=20

# Python toolchain for the SeleniumBase adapter builder + runtime
# stages.
PYTHON_VERSION=3.12

# protoc release used by the engine builder stage to satisfy
# build.rs's prost-build invocation. The Debian package's protoc does
# not ship the well-known .proto files in a location prost-build's
# default include resolution finds; the official release archive
# does. ADR-0007.
PROTOC_VERSION=27.2

# buf release used by the codegen stage of every Dockerfile that
# regenerates Go / Python / TS bindings inside the build context.
BUF_VERSION=1.55.1

# uv release used by the SeleniumBase adapter builder stage to
# resolve the Python venv. Pin tracks the Devcontainer + CI install.
UV_VERSION=0.5.11

# Playwright runtime image is pinned to the same version as the
# `playwright` npm dependency in adapters/playwright/package.json.
# Bumping one without the other causes Chromium / API drift.
PLAYWRIGHT_VERSION=1.49.0

# curl-impersonate upstream image. Provides the curl_chrome116 binary
# the adapter execs (adapters/curl-impersonate/internal/curlx). The
# multi-stage extractor copies the binary + its dynamically linked
# libcurl-impersonate-chrome shared library into the runtime stage,
# avoiding apt machinery in the runtime image.
CURL_IMPERSONATE_IMAGE=lwthiker/curl-impersonate:0.6-chrome

# Chrome stable version for the SeleniumBase adapter runtime stage.
# Aligned with seleniumbase>=4.32's tested matrix; the adapter
# invokes `seleniumbase install chromedriver` at image build time so
# the bundled ChromeDriver matches whichever Chrome is installed.
CHROME_VERSION=131.0.6778.85
